@model IEnumerable<EventEase.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h1>Venues</h1>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create New Venue
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Image</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Name</td>

                <td>@item.Location</td>

                <td>@item.Capacity</td>

                <td>
                    <img src="@item.ImageURL"
                         width="120"
                         height="80" />
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.VenueID">
                        Edit
                    </a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@item.VenueID">
                        Details
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@item.VenueID">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>