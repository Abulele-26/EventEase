@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-4">Bookings</h1>

<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="row">

        <div class="col-md-4">

            <input type="text"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Search Booking ID or Event Name" />

        </div>

        <div class="col-md-3">

            <div class="form-check mt-2">

                <input class="form-check-input"
                       type="checkbox"
                       name="availableOnly"
                       value="true"
                @(ViewBag.AvailableOnly ? "checked" : "") />

                <label class="form-check-label">
                    Available Only
                </label>

            </div>

        </div>

        <div class="col-md-3">

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index"
                   class="btn btn-secondary">
                Clear
            </a>

        </div>

    </div>

</form>

<p>
    <a asp-action="Create"
           class="btn btn-success">
        Create New Booking
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>
            <th>Booking ID</th>
            <th>Venue</th>
            <th>Event</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.BookingID</td>

                <td>
                    @(item.Venue?.Name ?? "No Venue")
                </td>

                <td>
                    @(item.Event?.Name ?? "No Event")
                </td>

                <td>
                    @item.StartDate.ToString("dd MMM yyyy HH:mm")
                </td>

                <td>
                    @item.EndDate.ToString("dd MMM yyyy HH:mm")
                </td>

                <td>

                    <a asp-action="Edit"
                           asp-route-id="@item.BookingID"
                           class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Details"
                           asp-route-id="@item.BookingID"
                           class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.BookingID"
                           class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>