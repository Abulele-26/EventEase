@model EventEase.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <h2 class="mb-4 text-primary">
            Create Event
        </h2>

        <hr />

        <div class="row">
            <div class="col-md-6">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- EVENT NAME -->
                    <div class="mb-3">
                        <label asp-for="Name"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter event name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- EVENT TYPE -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Event Type
                        </label>

                        <select asp-for="EventTypeID"
                                asp-items="ViewBag.EventTypeID"
                                class="form-control">
                            <option value="">
                                -- Select Event Type --
                            </option>
                        </select>

                        <span asp-validation-for="EventTypeID"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- START DATE -->
                    <div class="mb-3">
                        <label asp-for="StartDate"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="StartDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- END DATE -->
                    <div class="mb-3">
                        <label asp-for="EndDate"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="EndDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- IMAGE URL -->
                    <div class="mb-3">
                        <label asp-for="ImageURL"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="ImageURL"
                               class="form-control"
                               placeholder="Paste image URL" />

                        <span asp-validation-for="ImageURL"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- BUTTONS -->
                    <div class="mt-4">

                        <input type="submit"
                               value="Create Event"
                               class="btn btn-primary" />

                        <a asp-action="Index"
                               class="btn btn-secondary">
                            Back to List
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}